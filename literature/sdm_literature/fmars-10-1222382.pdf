<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="3.1-701">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Ruiju Tong</rdf:li>
               <rdf:li>Chris Yesson</rdf:li>
               <rdf:li>Jinsongdi Yu</rdf:li>
               <rdf:li>Yuan Luo</rdf:li>
               <rdf:li>Ling Zhang</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Species distribution modeling is a widely used technique for estimating the potential habitats of target organisms based on their environmental preferences.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Copyright Â© 2023 Tong, Yesson, Yu, Luo and Zhang. This is an open-access article distributed under the terms of the Creative Commons Attribution License (CC BY). The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms.</rdf:li>
            </rdf:Alt>
         </dc:rights>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Key factors for species distribution modeling in benthic marine environments</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>species distribution modeling</rdf:li>
               <rdf:li>benthic marine environments</rdf:li>
               <rdf:li>modeling algorithms</rdf:li>
               <rdf:li>collinearity</rdf:li>
               <rdf:li>presence-only</rdf:li>
               <rdf:li>background points</rdf:li>
               <rdf:li>model comparison</rdf:li>
               <rdf:li>model evaluation</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>species distribution modeling, benthic marine environments, modeling algorithms, collinearity, presence-only, background points, model comparison, model evaluation</pdf:Keywords>
